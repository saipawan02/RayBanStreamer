# Copy to /etc/glasses/telemetry.env (git-ignored when named .env). TECH-01 section 8.
DATA_ROOT=/srv/glasses
TELEMETRY_TOKEN=change-me-random-at-least-16-chars      # openssl rand -hex 24
TELEMETRY_BIND=100.x.y.z                                 # `tailscale ip -4`
PART_SECONDS=5
PART_ROWS=1000
LOG_LEVEL=info
